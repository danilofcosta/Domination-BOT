{
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",

    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2023",

    "types": ["node"],

    "strict": true,
    "esModuleInterop": true,

    "sourceMap": true,

    "isolatedModules": true,
    "verbatimModuleSyntax": true,

    "skipLibCheck": true
  },

  "include": ["src"]
}